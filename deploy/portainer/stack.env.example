# Set these in Portainer's stack environment variables, or upload a filled-in copy.
# All three published images use this prefix with -server, -web, or -ingress appended.
LANGWARS_IMAGE_PREFIX=ghcr.io/your-owner/your-repository
LANGWARS_IMAGE_TAG=v1.0.0
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
WORKER_REPLICAS=2
WORKER_MEMORY_MB=256
WORKER_TIMEOUT_SECONDS=20
SESSION_TTL_HOURS=168
LANGWARS_NETWORK_SUBNET=172.30.251.0/24
LANGWARS_NETWORK_GATEWAY=172.30.251.1

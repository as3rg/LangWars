# Install as /etc/nginx/conf.d/langwars.conf on the Docker host.
# Replace the domain, certificate paths, and upstream port with your values.
# This file is included inside nginx's http {} context.
upstream langwars_portainer {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name langwars.example.org;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 308 https://langwars.example.org$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    # nginx older than 1.25.1: replace the two lines above with listen 443 ssl http2;
    server_name langwars.example.org;
    ssl_certificate /etc/letsencrypt/live/langwars.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/langwars.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:LangWarsTLS:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://langwars_portainer;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite incoming values: this nginx is the public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
